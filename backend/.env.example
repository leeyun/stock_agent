# ============================================================
#  Trender backend 환경변수
#  - [필수]  : 비어 있으면 서버가 뜨지 않음
#  - [Google 로그인] : Google 로그인 버튼에만 필요
#  - [외부 공개] : scripts\manager.bat 의 ngrok 터널에만 필요
#  - [뉴스]  : 뉴스 수집(collect_news / Celery)에만 필요. 비어 있어도 서버와 다른 API는 동작
#  - [선택]  : 주석(#)을 풀고 값을 바꿀 때만 적용. 빈 값(KEY=)으로 두면 기본값이 아니라 빈 값이 들어가니 주의
# ============================================================

# [필수] Django 서명 키
DJANGO_SECRET_KEY=change-me

# [뉴스] 네이버 뉴스 검색 API (NAVER API HUB: https://api.ncloud-docs.com/docs/application-naver-api-hub)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [뉴스] Gemini API 키 (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# [Google 로그인] OAuth 클라이언트 ID - 웹 애플리케이션 유형 (https://console.cloud.google.com/apis/credentials)
# 승인된 JavaScript 원본에 http://localhost:3000 추가. 비어 있으면 Google 로그인 버튼만 비활성
GOOGLE_CLIENT_ID=

# [외부 공개] ngrok (scripts\manager.bat). 토큰이 ngrok.yml에 이미 있으면 비워둬도 됨
# NGROK_DOMAIN : 비우면 계정에 자동 배정된 dev 도메인(xxxx.ngrok-free.dev, 고정)을 사용. 유료 플랜의 다른 도메인을 쓸 때만 입력
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# [선택] Gemini 모델 / 요금제의 분당 요청 한도 / 뉴스 파이프라인 동시 실행 수 / 네이버 본문 동시 요청 수
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=15
# NEWS_PIPELINE_CONCURRENCY=4
# NAVER_FETCH_CONCURRENCY=2

# [선택] Flutter Web 배포 주소 (콤마 구분). 개발 중 localhost:<임의포트>는 DEBUG일 때 자동 허용
# CORS_ALLOWED_ORIGINS=https://trender.example.com
